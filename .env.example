# ── Base de datos ──────────────────────────────────────────────────────────
# Local (docker compose up -d db):
DATABASE_URL=postgres://decles:decles@localhost:54329/decles_stock
# Supabase: la pooled (puerto 6543) en DATABASE_URL y la directa (5432) para migrar.
# DATABASE_URL=postgres://postgres.xxxx:PASS@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# DATABASE_URL_DIRECT=postgres://postgres:PASS@db.xxxx.supabase.co:5432/postgres

# ── Auth ───────────────────────────────────────────────────────────────────
# En producción: string aleatorio de 32+ caracteres (openssl rand -base64 48).
AUTH_SECRET=

# ── Cron de avisos de vencimiento (Vercel lo manda solo si existe) ─────────
CRON_SECRET=

# ── Email para "Olvidé mi PIN" (sin esto, el código sale en la consola) ────
RESEND_API_KEY=
RESEND_FROM=
