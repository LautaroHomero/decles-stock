# ── Base de datos ──────────────────────────────────────────────────────────
# Local (docker compose up -d db):
DATABASE_URL=postgres://decles:decles@localhost:54329/decles_stock
# Neon (producción, ver DEPLOY.md): Vercel pone DATABASE_URL (pooler) solo; para migrar, la UNPOOLED:
# DATABASE_URL_DIRECT=postgresql://neondb_owner:PASS@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ── Auth ───────────────────────────────────────────────────────────────────
# En producción: string aleatorio de 32+ caracteres (openssl rand -base64 48).
AUTH_SECRET=

# ── Cron de avisos de vencimiento (Vercel lo manda solo si existe) ─────────
CRON_SECRET=

# ── Instalado en una PC (http, sin HTTPS): la cookie no puede ser Secure ──
# COOKIE_SECURE=false

# ── Mails para recuperar la contraseña (código de 6 dígitos) ───────────────
# Gmail del consultorio + contraseña de aplicación (ver DEPLOY.md). Sin esto: en desarrollo
# el código sale en la consola; en producción la opción queda apagada.
# SMTP_USER=consultorio.decles@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# Opcionales: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  MAIL_FROM="Consultorio Decles <consultorio.decles@gmail.com>"
